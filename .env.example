# Placeholders only. Never commit real values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
GEMINI_API_KEY=
# Caregiver escalation (Discord-compatible webhook; leave empty to only log + record)
ESCALATION_WEBHOOK_URL=
ESCALATION_REPEAT_MINUTES=10
ESCALATION_MAX_REPEATS=3
# Background jobs (escalation repeats, biweekly reports, token cleanup). Run ONE API worker.
SCHEDULER_ENABLED=true

# Copy to .env (never commit .env). Used by docker compose. Placeholders only.
JWT_SECRET=change-me-to-32-or-more-random-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
POSTGRES_PASSWORD=devpass
# For Tiger Cloud instead of the local db service:
# DATABASE_URL=postgresql+psycopg://user:pass@host:port/tsdb?sslmode=require

# Caregiver escalation (Discord-compatible webhook; leave empty to only log + record)
ESCALATION_WEBHOOK_URL=
ESCALATION_REPEAT_MINUTES=10
ESCALATION_MAX_REPEATS=3
# Background jobs (escalation repeats, biweekly reports, token cleanup). Run ONE API worker.
SCHEDULER_ENABLED=true
